Screen {
    layers: base overlay;
}

TabbedContent {
    height: 1fr;
}

/* ---- device ---- */

#device-body {
    height: 1fr;
}

.port-column {
    width: 1fr;
    border: round $panel;
    padding: 0 1;
    margin: 0 1;
}

.port-column.chosen {
    border: round $success;
}

.column-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#device-hint {
    padding: 1 2;
    color: $text-muted;
}

/* ---- browse ---- */

#browse-body {
    height: 1fr;
}

#file-pane {
    width: 32;
    border: round $panel;
}

#item-pane {
    width: 34;
    border: round $panel;
}

#detail-pane {
    width: 1fr;
    border: round $panel;
    padding: 0 1;
}

#detail {
    height: 1fr;
}

#detail-grid {
    /* The grid is monospace art; wrapping it would scramble the step columns. */
    width: auto;
}

#dir-input {
    dock: top;
    border: none;
    height: 3;
}

/* ---- transfer / firmware ---- */

.action-row {
    height: auto;
    padding: 1 1 0 1;
}

.action-row Input {
    width: 1fr;
}

.action-row Button {
    margin: 0 0 0 1;
}

.panel {
    border: round $panel;
    margin: 1;
    padding: 0 1;
    height: auto;
}

.panel-title {
    text-style: bold;
}

#transfer-log, #firmware-log {
    height: 1fr;
    border: round $panel;
    margin: 1;
}

ProgressBar {
    margin: 1 1 0 1;
    width: 1fr;
}

.warning {
    color: $warning;
}

.error {
    color: $error;
}

.ok {
    color: $success;
}

.muted {
    color: $text-muted;
}

#status {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

ConfirmScreen {
    align: center middle;
}

#confirm-box {
    width: 64;
    height: auto;
    border: thick $warning;
    background: $surface;
    padding: 1 2;
}

#confirm-buttons {
    height: auto;
    padding: 1 0 0 0;
    align: right middle;
}

#confirm-buttons Button {
    margin: 0 0 0 2;
}
